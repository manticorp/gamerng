{
  "name": "@manticorp/gamerng",
  "version": "0.3.1",
  "description": "The most powerful RNG in the world for game use - flexible, performant, seedable, serializable, reliable.",
  "main": "./dist/gamerng.cjs",
  "browser": "./dist/gamerng.js",
  "types": "./dist/gamerng.d.cts",
  "source": "./src/index.ts",
  "exports": {
    "import": {
      "types": "./dist/gamerng.d.mts",
      "default": "./lib/index.js"
    },
    "require": {
      "types": "./dist/gamerng.d.cts",
      "default": "./dist/gamerng.cjs"
    }
  },
  "type": "module",
  "scripts": {
    "test": "jest --coverage",
    "test-watch": "jest --coverage --watchAll",
    "build-copy": "npm run build && npm run copy",
    "ci": "npm t && npm run build && npm run docs && npm run copy",
    "copy": "copyfiles -f ./dist/*.* ./docs/js",
    "prebuild": "rimraf dist && rimraf lib && rimraf docs/js && node -p \"'export const CURRENT_VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/constants/libver.ts",
    "build": "npm run build-lib && npm run build-browser && npm run build-cjs && npm run build-min && npm run build-types",
    "build-lib": "npx tsc",
    "build-browser": "npx rollup -c rollup-browser.config.mjs",
    "build-cjs": "npx rollup -c rollup.config.mjs",
    "build-min": " npx google-closure-compiler --js='dist/gamerng.js' --js_output_file='dist/gamerng.min.js' --language_out=ECMASCRIPT_2016 -W QUIET",
    "watch": "npx tsc --watch",
    "build-types": "rollup -c rollup-types.config.mjs",
    "test-package": "node scripts/test-package.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test -- --runInBand && npm run build && npm run test-package && npm run test:release && npm run docs",
    "benchmark": "node benchmarks/run.mjs",
    "prepublishOnly": "node scripts/check-release.mjs",
    "docs": "node scripts/build-docs.mjs",
    "test:release": "node --test tests/release.test.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "package.json",
    "./dist/",
    "./lib/",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "funding": {
    "type": "individual",
    "url": "https://ko-fi.com/harrymustoeplayfair"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/manticorp/gamerng.git"
  },
  "homepage": "https://github.com/manticorp/gamerng",
  "bugs": {
    "url": "https://github.com/manticorp/gamerng/issues",
    "email": "harry.mustoeplayfair@gmail.com"
  },
  "keywords": [
    "rng",
    "game",
    "random",
    "dice",
    "normal",
    "distribution",
    "random number generator",
    "typescript",
    "chancy",
    "random choice",
    "weighted choice",
    "biased",
    "rpg",
    "roller",
    "rand",
    "randint",
    "randbetween"
  ],
  "author": "Harry Mustoe-Playfair <harry@mustoeplayfair.com>",
  "license": "MIT",
  "devDependencies": {
    "@babel/plugin-transform-private-property-in-object": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@types/jest": "^29.5.13",
    "copyfiles": "^2.4.1",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "google-closure-compiler": "^20240317.0.0",
    "jest": "^29.7.0",
    "neostandard": "^0.14.1",
    "rimraf": "^6.1.4",
    "rollup": "^4.24.3",
    "rollup-plugin-dts": "^6.5.1",
    "ts-jest": "^29.2.5",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "minimatch@>=7 <11.0.1": "11.0.1",
    "glob@>=9 <14.0.2": "14.0.2"
  }
}
